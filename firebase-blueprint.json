{
  "entities": {
    "SiteAccess": {
      "title": "SiteAccess",
      "description": "Global access lock configuration",
      "type": "object",
      "properties": {
        "requireStudentLogin": {
          "type": "boolean",
          "description": "Whether site requires student login"
        },
        "updatedAtMs": {
          "type": "number",
          "description": "Timestamp in milliseconds"
        }
      },
      "required": ["requireStudentLogin", "updatedAtMs"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Daily announcements for students",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "message": {
          "type": "string",
          "maxLength": 800
        },
        "tone": {
          "type": "string",
          "enum": ["info", "warn", "urgent"]
        },
        "active": {
          "type": "boolean"
        },
        "targetGroup": {
          "type": "string",
          "maxLength": 10
        },
        "targetProg": {
          "type": "string",
          "maxLength": 10
        },
        "createdAtMs": {
          "type": "number"
        },
        "updatedAtMs": {
          "type": "number"
        },
        "expiresAtMs": {
          "type": "number",
          "description": "Optional auto-expiry timestamp in milliseconds (0 or omitted means no expiry)"
        },
        "deleted": {
          "type": "boolean"
        }
      },
      "required": ["id", "title", "message", "tone", "active", "createdAtMs", "updatedAtMs"]
    },
    "StudentDirectory": {
      "title": "StudentDirectory",
      "description": "Consolidated student directory snapshot",
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "maxLength": 32
        },
        "updatedAtMs": {
          "type": "number"
        },
        "payload": {
          "type": "string",
          "maxLength": 1000000
        }
      },
      "required": ["updatedAtMs"]
    },
    "StudentPrefs": {
      "title": "StudentPrefs",
      "description": "Ultra-compact cross-device persisted student MBU/LAB group, display mode, and language preferences",
      "type": "object",
      "properties": {
        "g": {
          "type": "string",
          "enum": ["", "I", "II", "III", "IV", "V"],
          "maxLength": 4,
          "description": "MBU group (myMbuGroup)"
        },
        "l": {
          "type": "string",
          "enum": ["", "1", "2"],
          "maxLength": 2,
          "description": "LAB group (myLabGroup)"
        },
        "m": {
          "type": "string",
          "enum": ["d", "h"],
          "maxLength": 1,
          "description": "Other group display mode: d=dim, h=hide"
        },
        "p": {
          "type": "string",
          "enum": ["", "tr", "en"],
          "maxLength": 2,
          "description": "Program language preference"
        },
        "t": {
          "type": "number",
          "description": "Last updated timestamp in milliseconds"
        }
      },
      "required": ["g", "l", "m", "p", "t"]
    },
    "CancelledLesson": {
      "title": "CancelledLesson",
      "description": "Admin-cancelled lesson slot synchronized in real time across all student devices",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "date": {
          "type": "string",
          "maxLength": 20
        },
        "slotNo": {
          "type": "number"
        },
        "targetProg": {
          "type": "string",
          "enum": ["tr", "en"],
          "maxLength": 2
        },
        "reason": {
          "type": "string",
          "maxLength": 200
        },
        "updatedAtMs": {
          "type": "number"
        }
      },
      "required": ["id", "date", "slotNo", "targetProg", "reason", "updatedAtMs"]
    },
    "ExamCountdown": {
      "title": "ExamCountdown",
      "description": "Admin-managed exam / committee countdown item synchronized across all student devices",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "date": {
          "type": "string",
          "maxLength": 20
        },
        "time": {
          "type": "string",
          "maxLength": 32
        },
        "note": {
          "type": "string",
          "maxLength": 240
        },
        "targetProg": {
          "type": "string",
          "enum": ["", "tr", "en"],
          "maxLength": 2
        },
        "updatedAtMs": {
          "type": "number"
        }
      },
      "required": ["id", "title", "date", "time", "note", "targetProg", "updatedAtMs"]
    }
  },
  "firestore": {
    "/config/access": {
      "schema": {
        "$ref": "#/entities/SiteAccess"
      },
      "description": "Global site access lock state"
    },
    "/announcements/{announcementId}": {
      "schema": {
        "$ref": "#/entities/Announcement"
      },
      "description": "Student announcements"
    },
    "/directory/students": {
      "schema": {
        "$ref": "#/entities/StudentDirectory"
      },
      "description": "Consolidated student directory"
    },
    "/studentPrefs/{cloudKey}": {
      "schema": {
        "$ref": "#/entities/StudentPrefs"
      },
      "description": "Per-student MBU/LAB group, other-group display mode, and language preferences synced across devices"
    },
    "/cancelledLessons/{lessonId}": {
      "schema": {
        "$ref": "#/entities/CancelledLesson"
      },
      "description": "Admin-cancelled lesson slots synced across all devices"
    },
    "/examCountdowns/{examId}": {
      "schema": {
        "$ref": "#/entities/ExamCountdown"
      },
      "description": "Admin-managed exam countdown items synced across all devices"
    }
  }
}
