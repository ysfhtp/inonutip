{
  "entities": {
    "Announcement": {
      "description": "Daily or general announcements for students",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 2000 },
        "tone": { "type": "string", "maxLength": 50 },
        "active": { "type": "boolean" },
        "targetGroup": { "type": "string", "maxLength": 50 },
        "targetProg": { "type": "string", "maxLength": 50 },
        "deleted": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "title", "message"]
    },
    "LessonMaterial": {
      "description": "Shared PDF lesson materials and notes for specific lecture slots",
      "properties": {
        "id": { "type": "string", "maxLength": 150 },
        "date": { "type": "string", "maxLength": 50 },
        "slotNo": { "type": "number" },
        "targetProg": { "type": "string", "maxLength": 50 },
        "title": { "type": "string", "maxLength": 200 },
        "sourceType": { "type": "string", "maxLength": 50 },
        "pdfUrl": { "type": "string", "maxLength": 2000 },
        "pdfData": { "type": "string" },
        "chunkCount": { "type": "number" },
        "pdfName": { "type": "string", "maxLength": 200 },
        "fileSize": { "type": "number" },
        "deleted": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "date", "slotNo", "title"]
    },
    "StudentPrefs": {
      "description": "Student preferences for MBU and LAB groups",
      "properties": {
        "cloudKey": { "type": "string", "maxLength": 100 },
        "authHash": { "type": "string", "maxLength": 100 },
        "last4": { "type": "string", "maxLength": 10 },
        "myMbuGroup": { "type": "string", "maxLength": 50 },
        "myLabGroup": { "type": "string", "maxLength": 50 },
        "otherGroupMode": { "type": "string", "maxLength": 50 },
        "lang": { "type": "string", "maxLength": 10 },
        "updatedAt": { "type": "number" }
      },
      "required": ["cloudKey"]
    },
    "AdminConfig": {
      "description": "Site-wide configuration such as site access lock settings",
      "properties": {
        "key": { "type": "string", "maxLength": 100 },
        "value": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["key", "value"]
    }
  },
  "firestore": {
    "paths": {
      "/announcements/{announcementId}": {
        "entity": "Announcement",
        "read": "true",
        "write": "request.auth != null"
      },
      "/lesson_materials/{materialId}": {
        "entity": "LessonMaterial",
        "read": "true",
        "write": "request.auth != null"
      },
      "/student_prefs/{prefId}": {
        "entity": "StudentPrefs",
        "read": "true",
        "write": "true"
      },
      "/admin_config/{configKey}": {
        "entity": "AdminConfig",
        "read": "true",
        "write": "true"
      }
    }
  }
}
