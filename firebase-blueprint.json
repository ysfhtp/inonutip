{
  "entities": {
    "StudentPrefs": {
      "title": "StudentPrefs",
      "description": "Per-student non-PII schedule group and language preferences synchronized across devices by a runtime-derived 256-bit salted key.",
      "type": "object",
      "properties": {
        "myMbuGroup": {
          "type": "string",
          "enum": ["", "I", "II", "III", "IV", "V"],
          "maxLength": 3,
          "description": "Student's selected MBU / PSP group."
        },
        "myLabGroup": {
          "type": "string",
          "enum": ["", "1", "2"],
          "maxLength": 1,
          "description": "Student's selected LAB group."
        },
        "otherGroupMode": {
          "type": "string",
          "enum": ["dim", "hide"],
          "maxLength": 4,
          "description": "Display mode for other groups."
        },
        "lang": {
          "type": "string",
          "enum": ["", "tr", "en"],
          "maxLength": 2,
          "description": "Optional preferred schedule language."
        },
        "authHash": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[a-f0-9]{0,32}$",
          "description": "Optional salted 32-hex allowlist reference hash."
        },
        "last4": {
          "type": "string",
          "maxLength": 4,
          "pattern": "^[0-9]{0,4}$",
          "description": "Optional last 4 digits of student ID for masked admin display."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the latest preference update."
        }
      },
      "required": ["myMbuGroup", "myLabGroup", "otherGroupMode", "updatedAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Admin-managed campus or schedule notice displayed in the daily schedule view.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Short announcement heading."
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800,
          "description": "Announcement body text."
        },
        "tone": {
          "type": "string",
          "enum": ["info", "warn", "urgent"],
          "maxLength": 6,
          "description": "Visual severity tone."
        },
        "active": {
          "type": "boolean",
          "description": "Whether the announcement is visible to students."
        },
        "targetGroup": {
          "type": "string",
          "enum": ["", "I", "II", "III", "IV", "V"],
          "maxLength": 3,
          "description": "Target group filter or empty for all groups."
        },
        "targetProg": {
          "type": "string",
          "enum": ["", "tr", "en"],
          "maxLength": 2,
          "description": "Target program language filter or empty for all."
        },
        "deleted": {
          "type": "boolean",
          "description": "Soft-deletion flag controlled by verified admin proof."
        },
        "proofOpId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Atomic admin proof operation document ID."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest modification."
        }
      },
      "required": ["title", "message", "tone", "active", "targetGroup", "targetProg", "deleted", "proofOpId", "createdAt", "updatedAt"]
    },
    "LessonMaterial": {
      "title": "LessonMaterial",
      "description": "Admin-attached PDF learning material for a specific lesson slot.",
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "maxLength": 16,
          "description": "Lesson date (DD.MM.YYYY)."
        },
        "slotNo": {
          "type": "number",
          "description": "Slot number (1-10)."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Material title."
        },
        "sourceType": {
          "type": "string",
          "enum": ["url", "file"],
          "maxLength": 4,
          "description": "Whether the PDF is stored as an external link or uploaded file."
        },
        "pdfUrl": {
          "type": "string",
          "maxLength": 2000,
          "description": "PDF file URL or download link (empty when uploaded as file)."
        },
        "pdfData": {
          "type": "string",
          "maxLength": 950000,
          "description": "Optional base64-encoded PDF content for direct device downloads."
        },
        "pdfName": {
          "type": "string",
          "maxLength": 120,
          "description": "Optional PDF filename."
        },
        "deleted": {
          "type": "boolean",
          "description": "Soft-deletion flag."
        },
        "proofOpId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Admin proof op ID."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update."
        }
      },
      "required": ["date", "slotNo", "title", "pdfUrl", "deleted", "proofOpId", "createdAt", "updatedAt"]
    },
    "CustomStudent": {
      "title": "CustomStudent",
      "description": "Admin-added non-PII student login entry keyed by salted 32-hex auth hash.",
      "type": "object",
      "properties": {
        "group": {
          "type": "string",
          "enum": ["I", "II", "III", "IV", "V"],
          "maxLength": 3,
          "description": "Assigned MBU / PSP group."
        },
        "labGroup": {
          "type": "string",
          "enum": ["", "1", "2"],
          "maxLength": 1,
          "description": "Optional assigned LAB group."
        },
        "prog": {
          "type": "string",
          "enum": ["tr", "en"],
          "maxLength": 2,
          "description": "Assigned program language."
        },
        "encName": {
          "type": "string",
          "maxLength": 256,
          "description": "Student-ID-keyed XOR-encrypted student display name."
        },
        "encSid": {
          "type": "string",
          "maxLength": 128,
          "description": "Optional AES-GCM admin-key-encrypted full 11-digit student ID."
        },
        "last4": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4,
          "pattern": "^[0-9]{4}$",
          "description": "Last 4 digits of student ID."
        },
        "cloudKey": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$",
          "description": "Derived 64-hex cloud preference document ID."
        },
        "active": {
          "type": "boolean",
          "description": "Whether login is enabled for this custom student."
        },
        "deleted": {
          "type": "boolean",
          "description": "Soft-deletion flag controlled by verified admin proof."
        },
        "proofOpId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Atomic admin proof operation document ID."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update."
        }
      },
      "required": ["group", "labGroup", "prog", "encName", "last4", "cloudKey", "active", "deleted", "proofOpId", "createdAt", "updatedAt"]
    },
    "AdminStudentRecord": {
      "title": "AdminStudentRecord",
      "description": "Strict admin-only student directory record isolating student names from public reads.",
      "type": "object",
      "properties": {
        "authHash": {
          "type": "string",
          "minLength": 32,
          "maxLength": 32,
          "pattern": "^[a-f0-9]{32}$",
          "description": "32-hex student auth hash."
        },
        "cloudKey": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$",
          "description": "64-hex student prefs key."
        },
        "last4": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4,
          "pattern": "^[0-9]{4}$",
          "description": "Last 4 digits of student ID."
        },
        "encFullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Obfuscated/encrypted student display name for admin directory."
        },
        "encSid": {
          "type": "string",
          "maxLength": 128,
          "description": "Optional AES-GCM admin-key-encrypted full 11-digit student ID."
        },
        "group": {
          "type": "string",
          "enum": ["I", "II", "III", "IV", "V"],
          "maxLength": 3,
          "description": "Assigned MBU group."
        },
        "labGroup": {
          "type": "string",
          "enum": ["", "1", "2"],
          "maxLength": 1,
          "description": "Assigned LAB group."
        },
        "prog": {
          "type": "string",
          "enum": ["tr", "en"],
          "maxLength": 2,
          "description": "Program language."
        },
        "source": {
          "type": "string",
          "enum": ["allowlist", "custom"],
          "maxLength": 10,
          "description": "Origin of the student record."
        },
        "active": {
          "type": "boolean",
          "description": "Whether student account is active."
        },
        "deleted": {
          "type": "boolean",
          "description": "Soft-deletion flag controlled by verified admin proof."
        },
        "proofOpId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Atomic admin proof operation document ID."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["authHash", "cloudKey", "last4", "encFullName", "group", "labGroup", "prog", "source", "active", "deleted", "proofOpId", "createdAt", "updatedAt"]
    },
    "AdminSecurityConfig": {
      "title": "AdminSecurityConfig",
      "description": "Admin password digest configuration writable only with valid current admin proof.",
      "type": "object",
      "properties": {
        "passwordHash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$",
          "description": "Salted SHA-256 hash of admin login password."
        },
        "proofDigestB64": {
          "type": "string",
          "minLength": 44,
          "maxLength": 44,
          "description": "Base64 SHA-256 digest of the admin write secret."
        },
        "wrappedRosterKey": {
          "type": "string",
          "minLength": 64,
          "maxLength": 128,
          "pattern": "^[a-f0-9]{64,128}$",
          "description": "Optional admin-secret-wrapped master roster decryption key."
        },
        "proofOpId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Atomic admin proof operation document ID."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of password update."
        }
      },
      "required": ["passwordHash", "proofDigestB64", "proofOpId", "updatedAt"]
    },
    "AdminProof": {
      "title": "AdminProof",
      "description": "Write-only atomic proof document verifying admin password knowledge in write batches.",
      "type": "object",
      "properties": {
        "proof": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$",
          "description": "Admin write secret derived from the admin password."
        },
        "targetPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Exact target resource key bound to this batch."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp enforcing single-batch non-replayability."
        }
      },
      "required": ["proof", "targetPath", "createdAt"]
    }
  },
  "firestore": {
    "/student_prefs/{studentHash}": {
      "schema": { "$ref": "#/entities/StudentPrefs" },
      "description": "Stores each student's MBU/LAB group and visibility preferences keyed by a 64-hex SHA-256 key."
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "Stores admin-managed announcements shown in the daily view."
    },
    "/custom_students/{authHash}": {
      "schema": { "$ref": "#/entities/CustomStudent" },
      "description": "Stores admin-added custom students keyed by salted 32-hex auth hash."
    },
    "/admin_student_directory/{authHash}": {
      "schema": { "$ref": "#/entities/AdminStudentRecord" },
      "description": "Admin student directory storing encrypted names and group metadata."
    },
    "/admin_config/{configId}": {
      "schema": { "$ref": "#/entities/AdminSecurityConfig" },
      "description": "Stores salted SHA-256 admin password hash and write proof verifier for 01260102038."
    },
    "/admin_proofs/{opId}": {
      "schema": { "$ref": "#/entities/AdminProof" },
      "description": "Write-only atomic batch verification docs; unreadable by all clients."
    },
    "/lesson_materials/{lessonKey}": {
      "schema": { "$ref": "#/entities/LessonMaterial" },
      "description": "Stores admin-uploaded PDF materials for lesson slots."
    }
  }
}
