rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'ysfhtp6@gmail.com' && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidCloudKey(key) {
      return key is string && key.size() == 64 && key.matches('^[a-f0-9]{64}$');
    }

    function isValidStudentPrefs(data) {
      return data.keys().hasAll(['g', 'l', 'm', 'p', 't']) &&
        data.keys().hasOnly(['g', 'l', 'm', 'p', 't']) &&
        data.g is string && data.g.size() <= 4 && data.g in ['', 'I', 'II', 'III', 'IV', 'V'] &&
        data.l is string && data.l.size() <= 2 && data.l in ['', '1', '2'] &&
        data.m is string && data.m.size() == 1 && data.m in ['d', 'h'] &&
        data.p is string && data.p.size() <= 2 && data.p in ['', 'tr', 'en'] &&
        (data.t is int || data.t is float) && data.t >= 0;
    }

    // Startup connection validation
    match /test/{docId} {
      allow get: if true;
      allow write: if false;
    }

    // Site access lock setting
    match /config/access {
      allow get, list: if true;
      allow write: if true;
    }

    // Announcements
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow write: if true;
    }

    // Student directory
    match /directory/students {
      allow get, list: if true;
      allow write: if true;
    }

    function isValidCancelledLesson(data) {
      return data.keys().hasAll(['id', 'date', 'slotNo', 'targetProg', 'reason', 'updatedAtMs']) &&
        data.keys().hasOnly(['id', 'date', 'slotNo', 'targetProg', 'reason', 'updatedAtMs']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.date is string && data.date.size() >= 8 && data.date.size() <= 20 &&
        (data.slotNo is int || data.slotNo is float) && data.slotNo >= 1 && data.slotNo <= 20 &&
        data.targetProg is string && data.targetProg.size() == 2 && data.targetProg in ['tr', 'en'] &&
        data.reason is string && data.reason.size() <= 200 &&
        (data.updatedAtMs is int || data.updatedAtMs is float) && data.updatedAtMs >= 0;
    }

    // Cross-device student preferences (ultra-compact {g,l,m,p,t})
    match /studentPrefs/{cloudKey} {
      allow get: if isValidCloudKey(cloudKey);
      allow list: if false;
      allow create, update: if isValidCloudKey(cloudKey) && isValidStudentPrefs(request.resource.data);
    }

    // Cancelled lessons synced across all devices
    match /cancelledLessons/{lessonId} {
      allow get: if isValidId(lessonId);
      allow list: if true;
      allow create, update: if isValidId(lessonId) && isValidCancelledLesson(request.resource.data);
      allow delete: if isValidId(lessonId);
    }
  }
}
