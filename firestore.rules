rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all unspecified collections by default
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdminByEmail() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'ysfhtp6@gmail.com';
    }

    function isAdmin() {
      return isAdminByEmail()
        || (isSignedIn() && request.auth.token.email_verified == true && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidAuthHash(id) {
      return id is string && id.size() == 32 && id.matches('^[a-f0-9]{32}$');
    }

    function isValidStudentHash(id) {
      return id is string && id.size() == 64 && id.matches('^[a-f0-9]{64}$');
    }

    function hasValidAdminProof(proof) {
      return proof is string
        && proof.size() == 64
        && proof.matches('^[a-f0-9]{64}$')
        && (
          (
            (!exists(/databases/$(database)/documents/admin_config/security)
              || !('proofDigestB64' in get(/databases/$(database)/documents/admin_config/security).data))
            && hashing.sha256(proof.toUtf8()).toBase64() == 'NYixg8m6D55ww5bflL1j5si5a9Yb3lurTyAKeAOKDEs='
          )
          || (
            exists(/databases/$(database)/documents/admin_config/security)
            && 'proofDigestB64' in get(/databases/$(database)/documents/admin_config/security).data
            && hashing.sha256(proof.toUtf8()).toBase64() == get(/databases/$(database)/documents/admin_config/security).data.proofDigestB64
          )
        );
    }

    function isValidAdminProofDoc(data) {
      return data.keys().hasAll(['proof', 'targetPath', 'createdAt'])
        && data.keys().hasOnly(['proof', 'targetPath', 'createdAt'])
        && data.proof is string
        && data.proof.size() == 64
        && data.proof.matches('^[a-f0-9]{64}$')
        && data.targetPath is string
        && data.targetPath.size() >= 1
        && data.targetPath.size() <= 160
        && data.createdAt is timestamp;
    }

    function hasValidAdminBatchOp(opId, expectedTargetPath) {
      return isValidId(opId)
        && existsAfter(/databases/$(database)/documents/admin_proofs/$(opId))
        && getAfter(/databases/$(database)/documents/admin_proofs/$(opId)).data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/admin_proofs/$(opId)).data.targetPath == expectedTargetPath;
    }

    function isValidStudentPrefs(data) {
      return data.keys().hasAll(['myMbuGroup', 'myLabGroup', 'otherGroupMode', 'updatedAt'])
        && data.keys().hasOnly(['myMbuGroup', 'myLabGroup', 'otherGroupMode', 'lang', 'authHash', 'last4', 'updatedAt'])
        && data.myMbuGroup is string
        && data.myMbuGroup.size() <= 3
        && data.myMbuGroup in ['', 'I', 'II', 'III', 'IV', 'V']
        && data.myLabGroup is string
        && data.myLabGroup.size() <= 1
        && data.myLabGroup in ['', '1', '2']
        && data.otherGroupMode is string
        && data.otherGroupMode.size() <= 4
        && data.otherGroupMode in ['dim', 'hide']
        && (!('lang' in data) || (data.lang is string && data.lang.size() <= 2 && data.lang in ['', 'tr', 'en']))
        && (!('authHash' in data) || (data.authHash is string && data.authHash.size() <= 32 && data.authHash.matches('^[a-f0-9]{0,32}$')))
        && (!('last4' in data) || (data.last4 is string && data.last4.size() <= 4 && data.last4.matches('^[0-9]{0,4}$')))
        && data.updatedAt is timestamp;
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['title', 'message', 'tone', 'active', 'targetGroup', 'targetProg', 'deleted', 'proofOpId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'message', 'tone', 'active', 'targetGroup', 'targetProg', 'deleted', 'proofOpId', 'createdAt', 'updatedAt'])
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && data.message is string
        && data.message.size() >= 1
        && data.message.size() <= 800
        && data.tone is string
        && data.tone.size() <= 6
        && data.tone in ['info', 'warn', 'urgent']
        && data.active is bool
        && data.targetGroup is string
        && data.targetGroup.size() <= 3
        && data.targetGroup in ['', 'I', 'II', 'III', 'IV', 'V']
        && data.targetProg is string
        && data.targetProg.size() <= 2
        && data.targetProg in ['', 'tr', 'en']
        && data.deleted is bool
        && isValidId(data.proofOpId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLessonMaterial(data) {
      return data.keys().hasAll(['date', 'slotNo', 'title', 'pdfUrl', 'deleted', 'proofOpId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['date', 'slotNo', 'title', 'sourceType', 'pdfUrl', 'pdfData', 'pdfName', 'deleted', 'proofOpId', 'createdAt', 'updatedAt'])
        && data.date is string
        && data.date.size() >= 1
        && data.date.size() <= 16
        && data.slotNo is number
        && data.slotNo >= 1
        && data.slotNo <= 10
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && (!('sourceType' in data) || (data.sourceType is string && data.sourceType.size() <= 4 && data.sourceType in ['url', 'file']))
        && data.pdfUrl is string
        && data.pdfUrl.size() <= 2000
        && (!('pdfData' in data) || (data.pdfData is string && data.pdfData.size() <= 950000))
        && (!('pdfName' in data) || (data.pdfName is string && data.pdfName.size() <= 120))
        && (data.deleted == true || data.pdfUrl.size() >= 1 || ('pdfData' in data && data.pdfData.size() >= 1))
        && data.deleted is bool
        && isValidId(data.proofOpId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCustomStudent(data) {
      return data.keys().hasAll(['group', 'labGroup', 'prog', 'encName', 'last4', 'cloudKey', 'active', 'deleted', 'proofOpId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['group', 'labGroup', 'prog', 'encName', 'encSid', 'last4', 'cloudKey', 'active', 'deleted', 'proofOpId', 'createdAt', 'updatedAt'])
        && data.group is string
        && data.group.size() >= 1
        && data.group.size() <= 3
        && data.group in ['I', 'II', 'III', 'IV', 'V']
        && data.labGroup is string
        && data.labGroup.size() <= 1
        && data.labGroup in ['', '1', '2']
        && data.prog is string
        && data.prog.size() == 2
        && data.prog in ['tr', 'en']
        && data.encName is string
        && data.encName.size() <= 256
        && (!('encSid' in data) || (data.encSid is string && data.encSid.size() <= 128))
        && data.last4 is string
        && data.last4.size() == 4
        && data.last4.matches('^[0-9]{4}$')
        && data.cloudKey is string
        && data.cloudKey.size() == 64
        && data.cloudKey.matches('^[a-f0-9]{64}$')
        && data.active is bool
        && data.deleted is bool
        && isValidId(data.proofOpId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminStudentRecord(data) {
      return data.keys().hasAll(['authHash', 'cloudKey', 'last4', 'encFullName', 'group', 'labGroup', 'prog', 'source', 'active', 'deleted', 'proofOpId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['authHash', 'cloudKey', 'last4', 'encFullName', 'encSid', 'group', 'labGroup', 'prog', 'source', 'active', 'deleted', 'proofOpId', 'createdAt', 'updatedAt'])
        && data.authHash is string
        && data.authHash.size() == 32
        && data.authHash.matches('^[a-f0-9]{32}$')
        && data.cloudKey is string
        && data.cloudKey.size() == 64
        && data.cloudKey.matches('^[a-f0-9]{64}$')
        && data.last4 is string
        && data.last4.size() == 4
        && data.last4.matches('^[0-9]{4}$')
        && data.encFullName is string
        && data.encFullName.size() >= 1
        && data.encFullName.size() <= 256
        && (!('encSid' in data) || (data.encSid is string && data.encSid.size() <= 128))
        && data.group is string
        && data.group.size() >= 1
        && data.group.size() <= 3
        && data.group in ['I', 'II', 'III', 'IV', 'V']
        && data.labGroup is string
        && data.labGroup.size() <= 1
        && data.labGroup in ['', '1', '2']
        && data.prog is string
        && data.prog.size() == 2
        && data.prog in ['tr', 'en']
        && data.source is string
        && data.source.size() <= 10
        && data.source in ['allowlist', 'custom']
        && data.active is bool
        && data.deleted is bool
        && isValidId(data.proofOpId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminSecurityConfig(data) {
      return data.keys().hasAll(['passwordHash', 'proofDigestB64', 'proofOpId', 'updatedAt'])
        && data.keys().hasOnly(['passwordHash', 'proofDigestB64', 'wrappedRosterKey', 'proofOpId', 'updatedAt'])
        && data.passwordHash is string
        && data.passwordHash.size() == 64
        && data.passwordHash.matches('^[a-f0-9]{64}$')
        && data.proofDigestB64 is string
        && data.proofDigestB64.size() == 44
        && (!('wrappedRosterKey' in data) || (data.wrappedRosterKey is string && data.wrappedRosterKey.size() >= 64 && data.wrappedRosterKey.size() <= 128 && data.wrappedRosterKey.matches('^[a-f0-9]{64,128}$')))
        && isValidId(data.proofOpId)
        && data.updatedAt is timestamp;
    }

    // Write-only atomic admin proof collection (unreadable and non-replayable).
    match /admin_proofs/{opId} {
      allow read: if false;
      allow create: if isValidId(opId)
        && isValidAdminProofDoc(incoming())
        && incoming().createdAt == request.time
        && hasValidAdminProof(incoming().proof);
      allow update, delete: if false;
    }

    // Non-PII student schedule group & language preferences keyed by unguessable 256-bit salted hash.
    match /student_prefs/{studentHash} {
      allow get: if isValidStudentHash(studentHash);
      allow list: if request.query.limit <= 1000;
      allow create: if isValidStudentHash(studentHash)
        && isValidStudentPrefs(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isValidStudentHash(studentHash)
        && isValidStudentPrefs(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['myMbuGroup', 'myLabGroup', 'otherGroupMode', 'lang', 'authHash', 'last4', 'updatedAt'])
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidStudentHash(studentHash);
    }

    // Announcements readable when not soft-deleted (or missing); writes require atomic admin proof batch.
    match /announcements/{announcementId} {
      allow get: if isValidId(announcementId) && (resource == null || !('deleted' in existing()) || existing().deleted != true);
      allow list: if request.query.limit <= 200;
      allow create: if isValidId(announcementId)
        && isValidAnnouncement(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isAdmin() || hasValidAdminBatchOp(incoming().proofOpId, 'announcements/' + announcementId));
      allow update: if isValidId(announcementId)
        && isValidAnnouncement(incoming())
        && (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt)
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'message', 'tone', 'active', 'targetGroup', 'targetProg', 'deleted', 'proofOpId', 'updatedAt'])
        && incoming().updatedAt == request.time
        && (isAdmin() || hasValidAdminBatchOp(incoming().proofOpId, 'announcements/' + announcementId));
      allow delete: if isAdmin() && isValidId(announcementId);
    }

    // Admin-attached PDF learning materials for lesson slots.
    match /lesson_materials/{lessonKey} {
      allow get: if isValidId(lessonKey) && (resource == null || !('deleted' in existing()) || existing().deleted != true);
      allow list: if request.query.limit <= 500;
      allow create: if isValidId(lessonKey)
        && isValidLessonMaterial(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isAdmin() || hasValidAdminBatchOp(incoming().proofOpId, 'lesson_materials/' + lessonKey));
      allow update: if isValidId(lessonKey)
        && isValidLessonMaterial(incoming())
        && (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt)
        && incoming().diff(existing()).affectedKeys().hasOnly(['date', 'slotNo', 'title', 'sourceType', 'pdfUrl', 'pdfData', 'pdfName', 'deleted', 'proofOpId', 'updatedAt'])
        && incoming().updatedAt == request.time
        && (isAdmin() || hasValidAdminBatchOp(incoming().proofOpId, 'lesson_materials/' + lessonKey));
      allow delete: if isAdmin() && isValidId(lessonKey);
    }

    // Custom student login entries keyed by salted 32-hex hash (zero plaintext PII).
    match /custom_students/{authHash} {
      allow get: if isValidAuthHash(authHash);
      allow list: if request.query.limit <= 1000;
      allow create: if isValidAuthHash(authHash)
        && isValidCustomStudent(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isAdmin() || hasValidAdminBatchOp(incoming().proofOpId, 'student/' + authHash));
      allow update: if isValidAuthHash(authHash)
        && isValidCustomStudent(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['group', 'labGroup', 'prog', 'encName', 'encSid', 'last4', 'cloudKey', 'active', 'deleted', 'proofOpId', 'updatedAt'])
        && incoming().updatedAt == request.time
        && (isAdmin() || hasValidAdminBatchOp(incoming().proofOpId, 'student/' + authHash));
      allow delete: if isAdmin() && isValidAuthHash(authHash);
    }

    // Encrypted student directory storing obfuscated names & IDs; writes require atomic admin proof batch.
    match /admin_student_directory/{authHash} {
      allow get: if isValidAuthHash(authHash);
      allow list: if request.query.limit <= 1000;
      allow create: if isValidAuthHash(authHash)
        && isValidAdminStudentRecord(incoming())
        && incoming().authHash == authHash
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isAdmin() || hasValidAdminBatchOp(incoming().proofOpId, 'student/' + authHash));
      allow update: if isValidAuthHash(authHash)
        && isValidAdminStudentRecord(incoming())
        && incoming().authHash == existing().authHash
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['cloudKey', 'last4', 'encFullName', 'fullName', 'encSid', 'group', 'labGroup', 'prog', 'source', 'active', 'deleted', 'proofOpId', 'updatedAt'])
        && incoming().updatedAt == request.time
        && (isAdmin() || hasValidAdminBatchOp(incoming().proofOpId, 'student/' + authHash));
      allow delete: if isAdmin() && isValidAuthHash(authHash);
    }

    // Salted SHA-256 admin password verification digest & proof verifier.
    match /admin_config/{configId} {
      allow get: if isValidId(configId) && configId == 'security';
      allow list: if false;
      allow create: if isValidId(configId)
        && configId == 'security'
        && isValidAdminSecurityConfig(incoming())
        && incoming().updatedAt == request.time
        && (isAdmin() || hasValidAdminBatchOp(incoming().proofOpId, 'admin_config/security'));
      allow update: if isValidId(configId)
        && configId == 'security'
        && isValidAdminSecurityConfig(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['passwordHash', 'proofDigestB64', 'wrappedRosterKey', 'proofOpId', 'updatedAt'])
        && incoming().updatedAt == request.time
        && (isAdmin() || hasValidAdminBatchOp(incoming().proofOpId, 'admin_config/security'));
      allow delete: if false;
    }

    // Explicit admins registry (read-only by self/admins).
    match /admins/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (request.auth.uid == uid || isAdminByEmail());
      allow list: if isAdminByEmail();
      allow write: if false;
    }
  }
}
