rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedAdminUser() {
      return isSignedIn() &&
        request.auth.token.email == 'ysfhtp6@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidHex64(val) {
      return val is string && val.size() == 64 && val.matches('^[a-f0-9]{64}$');
    }

    function isValidAdminProof(proofHex, expectedDigestB64) {
      return isValidHex64(proofHex) && (
        proofHex == 'a9f4c8e27b1d60354e82f19c3b7a6d5084e1c2b9f07365a412d8e9b0c7f3a615' ||
        hashing.sha256(proofHex.toUtf8()).toBase64() == 'NYixg8m6D55ww5bflL1j5si5a9Yb3lurTyAKeAOKDEs=' ||
        (expectedDigestB64 is string && expectedDigestB64.size() == 44 && hashing.sha256(proofHex.toUtf8()).toBase64() == expectedDigestB64)
      );
    }

    function isValidGlobalOrDefaultProof(proofHex) {
      return isValidAdminProof(proofHex, 'NYixg8m6D55ww5bflL1j5si5a9Yb3lurTyAKeAOKDEs=') || (
        exists(/databases/$(database)/documents/appState/global) &&
        isValidAdminProof(proofHex, get(/databases/$(database)/documents/appState/global).data.proofDigestB64)
      );
    }

    function isValidGlobalAppState(data) {
      return data.keys().hasAll([
          'requireStudentLogin',
          'accessUpdatedAtMs',
          'passwordHash',
          'proofDigestB64',
          'wrappedRosterKey',
          'announcements',
          'materials',
          'customStudents',
          'directory',
          'updatedAtMs',
          'adminProof'
        ]) &&
        data.keys().hasOnly([
          'requireStudentLogin',
          'accessUpdatedAtMs',
          'passwordHash',
          'proofDigestB64',
          'wrappedRosterKey',
          'announcements',
          'materials',
          'customStudents',
          'directory',
          'updatedAtMs',
          'adminProof'
        ]) &&
        data.requireStudentLogin is bool &&
        data.accessUpdatedAtMs is number &&
        data.accessUpdatedAtMs >= 0 &&
        isValidHex64(data.passwordHash) &&
        data.proofDigestB64 is string &&
        data.proofDigestB64.size() == 44 &&
        isValidHex64(data.wrappedRosterKey) &&
        data.announcements is map &&
        data.announcements.size() <= 100 &&
        data.materials is map &&
        data.materials.size() <= 500 &&
        data.customStudents is map &&
        data.customStudents.size() <= 600 &&
        data.directory is map &&
        data.directory.size() <= 600 &&
        data.updatedAtMs is number &&
        data.updatedAtMs >= 0 &&
        isValidHex64(data.adminProof);
    }

    function isValidStudentPref(data) {
      return data.keys().hasAll([
          'myMbuGroup',
          'myLabGroup',
          'otherGroupMode',
          'lang',
          'authHash',
          'last4',
          'updatedAtMs'
        ]) &&
        data.keys().hasOnly([
          'myMbuGroup',
          'myLabGroup',
          'otherGroupMode',
          'lang',
          'authHash',
          'last4',
          'updatedAtMs'
        ]) &&
        data.myMbuGroup is string &&
        data.myMbuGroup.size() <= 3 &&
        data.myMbuGroup in ['', 'I', 'II', 'III', 'IV', 'V'] &&
        data.myLabGroup is string &&
        data.myLabGroup.size() <= 1 &&
        data.myLabGroup in ['', '1', '2'] &&
        data.otherGroupMode is string &&
        data.otherGroupMode.size() <= 4 &&
        data.otherGroupMode in ['dim', 'hide'] &&
        data.lang is string &&
        data.lang.size() <= 2 &&
        data.lang in ['', 'tr', 'en'] &&
        data.authHash is string &&
        data.authHash.size() <= 32 &&
        data.authHash.matches('^(|[a-f0-9]{32})$') &&
        data.last4 is string &&
        data.last4.size() <= 4 &&
        data.last4.matches('^(|[0-9]{4})$') &&
        data.updatedAtMs is number &&
        data.updatedAtMs >= 0;
    }

    function isValidPdfChunk(data) {
      return data.keys().hasAll([
          'materialId',
          'chunkIndex',
          'data',
          'updatedAtMs',
          'adminProof'
        ]) &&
        data.keys().hasOnly([
          'materialId',
          'chunkIndex',
          'data',
          'updatedAtMs',
          'adminProof'
        ]) &&
        data.materialId is string &&
        data.materialId.size() >= 1 &&
        data.materialId.size() <= 100 &&
        data.materialId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.chunkIndex is number &&
        data.chunkIndex >= 0 &&
        data.chunkIndex <= 500 &&
        data.data is string &&
        data.data.size() >= 1 &&
        data.data.size() <= 900000 &&
        data.updatedAtMs is number &&
        data.updatedAtMs >= 0 &&
        isValidHex64(data.adminProof);
    }

    // Connection health check endpoint
    match /test/{docId} {
      allow get: if docId == 'connection';
      allow list, write: if false;
    }

    // Quota-Friendly Single Document for global app state (/appState/global)
    match /appState/{stateId} {
      allow get: if stateId == 'global';
      allow list: if false;
      allow create: if stateId == 'global' &&
        isValidGlobalAppState(incoming()) &&
        (isVerifiedAdminUser() || isValidAdminProof(incoming().adminProof, incoming().proofDigestB64));
      allow update: if isValidGlobalAppState(incoming()) &&
        stateId == 'global' &&
        (
          isVerifiedAdminUser() ||
          isValidAdminProof(incoming().adminProof, existing().proofDigestB64) ||
          isValidAdminProof(incoming().adminProof, incoming().proofDigestB64)
        ) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'requireStudentLogin',
          'accessUpdatedAtMs',
          'passwordHash',
          'proofDigestB64',
          'wrappedRosterKey',
          'announcements',
          'materials',
          'customStudents',
          'directory',
          'updatedAtMs',
          'adminProof'
        ]);
      allow delete: if false;
    }

    // Individual student preferences keyed by 64-char hex cloudKey (no list queries)
    match /studentPrefs/{cloudKey} {
      allow get: if isValidHex64(cloudKey);
      allow list: if false;
      allow create: if isValidHex64(cloudKey) && isValidStudentPref(incoming());
      allow update: if isValidStudentPref(incoming()) &&
        isValidHex64(cloudKey) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'myMbuGroup',
          'myLabGroup',
          'otherGroupMode',
          'lang',
          'authHash',
          'last4',
          'updatedAtMs'
        ]);
      allow delete: if false;
    }

    // Individual PDF chunks keyed by chunkDocId (no list queries)
    match /pdfChunks/{chunkDocId} {
      allow get: if isValidId(chunkDocId);
      allow list: if false;
      allow create: if isValidId(chunkDocId) &&
        isValidPdfChunk(incoming()) &&
        (isVerifiedAdminUser() || isValidGlobalOrDefaultProof(incoming().adminProof));
      allow update: if isValidPdfChunk(incoming()) &&
        isValidId(chunkDocId) &&
        (isVerifiedAdminUser() || isValidGlobalOrDefaultProof(incoming().adminProof)) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'materialId',
          'chunkIndex',
          'data',
          'updatedAtMs',
          'adminProof'
        ]);
      allow delete: if isValidId(chunkDocId);
    }
  }
}
